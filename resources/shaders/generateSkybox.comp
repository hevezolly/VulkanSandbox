#version 450
#extension GL_ARB_shading_language_include : enable
#include <commonData.glsl>
#include <utils.glsl>

layout(binding = 0) uniform LightsData {
    LightData Lights;
};

layout(binding = 1) uniform GenData {
    vec3 SkyColor;
    int CubemapSize;

    vec3 GroundColor;
    float GroundTransition;
};

layout(r11f_g11f_b10f, set = 0, binding = 2) writeonly uniform imageCube outCubemap;


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {

    ivec3 texelCord = ivec3(gl_GlobalInvocationID.xyz);

    vec3 wsDir = cubeTexelDirection(texelCord.z, texelCord.xy, CubemapSize);

    // Elevation above the horizon in degrees (+Z is up): 90 = up, -90 = down.
    float elevation = degrees(asin(clamp(wsDir.z, -1.0, 1.0)));
    float halfTransition = max(GroundTransition * 0.5, 1e-4);
    // 0 above +halfTransition, 1 below -halfTransition, blended in between.
    float groundT = 1.0 - smoothstep(-halfTransition, halfTransition, elevation);

    vec3 color = mix(SkyColor, GroundColor, groundT);

    imageStore(outCubemap, texelCord, vec4(color, 0));
}
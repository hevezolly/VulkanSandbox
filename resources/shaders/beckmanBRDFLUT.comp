#version 450
#extension GL_ARB_shading_language_include : enable
#include <utils.glsl>
#include <brdf.glsl>

layout(rg16f, binding = 0) writeonly uniform image2D brdfLookup;

vec2 integrateBeckmannAB(float NoV, float roughness)
{
    NoV = clamp(NoV, 1e-4, 1.0);
    roughness = clamp(roughness, 0.0, 1.0);

    // Perfectly smooth limit: just Schlick Fresnel.
    if (roughness <= 0.0) {
        float Fc = pow(1.0 - NoV, 5.0);
        return vec2(1.0 - Fc, Fc);
    }

    vec3 N = vec3(0.0, 0.0, 1.0);
    vec3 V = vec3(sqrt(1.0 - NoV * NoV), 0.0, NoV);

    float alpha = roughness * roughness;
    vec2 AB = vec2(0.0);

    const uint SAMPLE_COUNT = 1024u;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 xi = vec2(
            (float(i) + 0.5) / float(SAMPLE_COUNT),
            radicalInverse(i)
        );

        vec3 H = importanceSampleBeckmann(xi, N, roughness);

        float VoH = dot(V, H);
        if (VoH <= 0.0)
            continue;

        vec3 L = reflect(-V, H);

        float NoL = max(L.z, 0.0);
        float NoH = max(H.z, 0.0);

        if (NoL <= 0.0 || NoH <= 0.0)
            continue;

        // Matches your geometry approximation, with both directions.
        float G = geometricShadowing(NoV, alpha)
                * geometricShadowing(NoL, alpha);

        // BRDF * NoL / sampling PDF, with Fresnel factored out.
        float weight = G * VoH / (NoV * NoH);

        float Fc = pow(1.0 - clamp(VoH, 0.0, 1.0), 5.0);

        AB.x += (1.0 - Fc) * weight;
        AB.y += Fc * weight;
    }

    // Divide by ALL samples, including rejected ones.
    return AB / float(SAMPLE_COUNT);
}

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(brdfLookup);

    if (any(greaterThanEqual(texelCoord, size)))
        return;

    float NoV = (float(texelCoord.x) + 0.5) / size.x;
    float roughness = (float(texelCoord.y) + 0.5) / size.y;

    vec2 result = integrateBeckmannAB(NoV, roughness);
    imageStore(brdfLookup, texelCoord, vec4(result, 0, 0));
}